# Copy to .env and fill in, or just export these in your shell.
# Without a key the app still runs end to end and serves the reviewed static
# result copy from lib/copy.js.

# Get one at https://openrouter.ai/keys
# Put the real value in .env (gitignored), never here — this file is committed.
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Optional. Any slug from https://openrouter.ai/models
# Default: google/gemini-3.6-flash — passed 10/10 constraint checks in testing,
# ~$1.51 to generate all 448 variants (the whole app, forever).
# OPENROUTER_MODEL=google/gemini-3.6-flash
#
# Cheaper, but needs the retry more often (~7/10 passed, rest serve static copy):
#   google/gemini-2.5-flash      (~$0.41 for all 448)
#   google/gemini-3.1-flash-lite (~$0.28 for all 448)
#
# Do not use Opus-tier models on this project.

# Optional. `off` bypasses data/result-copy.json and generates every result block
# through the API instead, so copy is written per visitor. Leave unset to prefer the
# reviewed file whenever it exists — that is the path where a person has read every
# string. Set it to `off` only when live generation is the point: the tradeoff is a
# ~5s cold call on the first request per variant, and unreviewed copy reaching
# visitors whenever the validator passes something a person would not have.
# FROZEN_COPY=off

# Optional. Reasoning depth: low | medium | high.
# Default low — this is short, tightly-specified microcopy.
# Note Gemini bills reasoning tokens at the output rate, so medium/high costs more.
# RESULT_EFFORT=low

# Optional. Request timeout in ms. Default 30000.
# OPENROUTER_TIMEOUT_MS=30000

# Optional. Attribution on openrouter.ai rankings.
# OPENROUTER_SITE_URL=https://newprogram.revou.co
# OPENROUTER_APP_NAME=RevoU HR Path Teaser

# Optional. Default 3000.
# PORT=3000
